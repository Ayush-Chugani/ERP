# Place in an nginx http-context include after replacing every example.invalid/path.
# Obtain the certificate before enabling the TLS server. Gunicorn remains loopback-only.
limit_req_zone $binary_remote_addr zone=sims_login:10m rate=5r/m;
map $uri $sims_csp {
    default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'";
    ~^/(api|admin)/ "";
}
server {
    listen 80;
    server_name example.invalid;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name example.invalid;
    ssl_certificate /etc/letsencrypt/live/example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/sims/current/frontend/dist;
    client_max_body_size 1m;
    client_body_timeout 15s;
    proxy_connect_timeout 5s;
    proxy_read_timeout 65s;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy $sims_csp always;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # This template assumes nginx is the public edge, not behind another proxy.
    proxy_set_header X-Forwarded-For $remote_addr;
    location = /api/v1/auth/login/ {
        limit_req zone=sims_login burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
    }
    location /api/ { proxy_pass http://127.0.0.1:8000; }
    location = /api { return 308 /api/; }
    location /admin/ { proxy_pass http://127.0.0.1:8000; }
    location = /admin { return 308 /admin/; }
    location /static/ { alias /srv/sims/current/backend/staticfiles/; }
    location /media/ { return 404; } # No public organization uploads in this release.
    location = /static { return 404; }
    location = /media { return 404; }
    location = /sw.js { expires -1; try_files $uri =404; }
    location = /manifest.webmanifest { expires -1; try_files $uri =404; }
    location = /index.html { expires -1; try_files $uri =404; }
    location /assets/ { expires 1y; try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
