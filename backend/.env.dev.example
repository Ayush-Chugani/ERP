# Local development settings for the whole SIMS stack.
# Do NOT commit a real .env. scripts/setup-dev.ps1 copies this to backend/.env and replaces
# every __GENERATE__ value with a fresh random secret for your machine.

DJANGO_SECRET_KEY=__GENERATE__
SIMS_DB_PASSWORD=__GENERATE__
SIMS_FEEDBACK_PRIVACY_KEY=__GENERATE__

SIMS_DB_USER=root
SIMS_DB_HOST=127.0.0.1
SIMS_DB_PORT=3307
SIMS_DB_NAME=sims_reference_dev
SIMS_DISPLAY_TIME_ZONE=UTC

# Development only: switch every staged module on so every screen can be explored with sample data.
SIMS_STUDENT_SUPPORT_ENABLED=1
SIMS_STUDENT_SUPPORT_INSTITUTIONS=1
SIMS_STUDENT_SUPPORT_POLICIES={"1":{"allow_overlapping_mentors":true,"student_normal_notes":true,"student_assignment_read":true,"session_within_assignment":true}}
SIMS_ADMISSION_ENROLMENT_ENABLED=1
SIMS_ATTENDANCE_ENABLED=1
SIMS_ASSESSMENTS_RESULTS_ENABLED=1
SIMS_FEEDBACK_ENABLED=1
SIMS_DOCUMENTS_EXIT_ENABLED=1
SIMS_DOCUMENTS_EXIT_INSTITUTIONS=1
SIMS_COMMUNICATION_ENABLED=1
SIMS_COMMUNICATION_INSTITUTIONS=1
SIMS_IDENTITY_ACCESS_ENABLED=1
SIMS_IDENTITY_ACCESS_SECURITY_ENABLED=1
SIMS_CONFERENCES_ENABLED=1
SIMS_CONSULTANCY_ENABLED=1
SIMS_COCURRICULAR_ENABLED=1
SIMS_EXTRACURRICULAR_ENABLED=1
SIMS_AWARDS_ENABLED=1
SIMS_PROFESSIONAL_CONTRIBUTIONS_ENABLED=1
SIMS_PROFESSIONAL_MEMBERSHIPS_ENABLED=1
SIMS_RESEARCH_PROPOSALS_ENABLED=1
SIMS_FUNDED_PROJECTS_ENABLED=1
SIMS_FACULTY_INTERNSHIPS_ENABLED=1
SIMS_EVIDENCE_ENABLED=1
SIMS_TEACHING_TIMETABLE_ENABLED=1
SIMS_TERM_REGISTRATION_ENABLED=1
