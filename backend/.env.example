# Copy to .env (never commit .env). Every setting is prefixed SIMS_.
SIMS_ENV=development                     # development | test | production

# --- Database: PostgreSQL. Local Docker (compose.yaml) or Supabase. -------------------------------------------------
SIMS_DATABASE_URL=postgresql+psycopg://sims:sims_dev_password@127.0.0.1:54329/sims
# Supabase: Project settings -> Database -> Connection string. Use the *Session pooler* string (IPv4, port 5432) and
# URL-encode special characters in the password (@ becomes %40):
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# For the transaction pooler (port 6543) also set SIMS_DB_POOLER=transaction.
SIMS_DB_POOLER=none
SIMS_DB_POOL_SIZE=10
SIMS_DB_MAX_OVERFLOW=10

# --- Security -------------------------------------------------------------------------------------------------------
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SIMS_SECRET_KEY=change-me
SIMS_COOKIE_SECURE=true                  # false only for plain-http local development
SIMS_COOKIE_SAMESITE=strict
SIMS_ALLOWED_HOSTS=localhost,127.0.0.1   # production: your real host names, never *
SIMS_CORS_ORIGINS=                       # empty when the UI is served from the same origin (recommended)
SIMS_DOCS_ENABLED=true                   # set false in production to hide /api/docs
SIMS_TRUSTED_PROXY_HOPS=1                # number of reverse proxies in front of the API (for client IPs)
# Encryption for Aadhaar / PAN / bank numbers (required in production):
#   SIMS_FIELD_ENCRYPTION_KEYS={"1":"<base64 of 32 random bytes>"}   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SIMS_FIELD_ENCRYPTION_KEYS=
SIMS_FINGERPRINT_KEY=

# --- Sessions and rate limits ---------------------------------------------------------------------------------------
SIMS_ACCESS_TOKEN_MINUTES=10
SIMS_REFRESH_TOKEN_DAYS=7
SIMS_REFRESH_IDLE_DAYS=2
SIMS_RATE_LOGIN=10/60                    # attempts / seconds, per IP and per username
SIMS_RATE_DEFAULT=300/60                 # requests / seconds, per signed-in user

# --- Files (private object storage) ---------------------------------------------------------------------------------
SIMS_STORAGE_BACKEND=local               # local | s3 (Supabase Storage S3 API or any S3-compatible bucket)
SIMS_STORAGE_LOCAL_ROOT=./var/private_files
SIMS_STORAGE_S3_ENDPOINT=
SIMS_STORAGE_S3_BUCKET=
SIMS_STORAGE_S3_ACCESS_KEY=
SIMS_STORAGE_S3_SECRET_KEY=

# --- First administrator (used by `python -m app.cli create-admin`) ---------------------------------------------------
SIMS_BOOTSTRAP_ADMIN_USERNAME=
SIMS_BOOTSTRAP_ADMIN_EMAIL=
SIMS_BOOTSTRAP_ADMIN_PASSWORD=

# --- AI features (Featherless, OpenAI-compatible). Off unless enabled AND a key is set. Key is server-side only. ---
SIMS_AI_ENABLED=false
SIMS_AI_BASE_URL=https://api.featherless.ai/v1
SIMS_AI_API_KEY=
SIMS_AI_MODEL=Qwen/Qwen2.5-7B-Instruct
SIMS_AI_TIMEOUT_SECONDS=45
SIMS_AI_MAX_TOKENS=700
SIMS_AI_RATE=20/60                       # requests / seconds, per user
