DJANGO_SECRET_KEY=replace-with-random-secret
SIMS_DB_PASSWORD=replace-with-local-root-password
SIMS_DB_USER=root
SIMS_DB_HOST=127.0.0.1
SIMS_DB_PORT=3307
SIMS_DB_NAME=sims_reference_dev
SIMS_DISPLAY_TIME_ZONE=UTC
DJANGO_ALLOWED_HOSTS=replace-with-production-hostname

# M9 stays off until calendar integration and section policies are approved.
SIMS_ATTENDANCE_ENABLED=0
SIMS_ATTENDANCE_CALENDAR_ADAPTER=

# M10: activate only after approved policies and pilot acceptance.
SIMS_ASSESSMENTS_RESULTS_ENABLED=0

# M11: remain disabled until privacy policy and pilot acceptance.
SIMS_FEEDBACK_ENABLED=0
# Persistent random secret (at least 32 characters); store securely and back up.
# Do not rotate while a cycle is open: a changed key fails closed.
SIMS_FEEDBACK_PRIVACY_KEY=

# M12: canonical table schemas stay unchanged; pilot activation is configuration-only.
SIMS_STUDENT_SUPPORT_ENABLED=0
SIMS_STUDENT_SUPPORT_INSTITUTIONS=
SIMS_STUDENT_SUPPORT_NUMBER_PREFIX=GR
# JSON keyed by institution ID; defaults allow overlaps and student NORMAL notes.
SIMS_STUDENT_SUPPORT_POLICIES={}

# M13 remains disabled until approved private storage, scanner, template and clearance integration.
SIMS_DOCUMENTS_EXIT_ENABLED=0
SIMS_DOCUMENTS_EXIT_INSTITUTIONS=
SIMS_DOCUMENTS_EXIT_POLICIES={}
SIMS_DOCUMENTS_NUMBER_PREFIX=SIMS
SIMS_DOCUMENTS_MAX_BYTES=10485760
SIMS_DOCUMENTS_STORAGE_FACTORY=apps.documents_exit.storage.LocalPrivateStorage
SIMS_DOCUMENTS_MALWARE_SCANNER=
SIMS_DOCUMENTS_CERTIFICATE_RENDERER=
SIMS_DOCUMENTS_EXIT_CLEARANCE=

# M14 Communication remains opt-in. Attachments also require M13 activation.
SIMS_COMMUNICATION_ENABLED=0
SIMS_COMMUNICATION_INSTITUTIONS=

# M26: enable only after scoped grants and institutional finance acceptance.
SIMS_FUNDED_PROJECTS_ENABLED=0
SIMS_FUNDED_PROJECTS_CURRENCIES=INR
SIMS_FUNDED_PROJECTS_RATE=120/min

# M27: stage permissions and finance acceptance before activation.
SIMS_CONSULTANCY_ENABLED=0
SIMS_CONSULTANCY_RATE=120/min

# M28: configure permissions, scanner and adapter before activation.
SIMS_COCURRICULAR_ENABLED=0
SIMS_COCURRICULAR_RATE=120/min
SIMS_COCURRICULAR_EVENT_HANDLER=

# M29 extra-curricular activities
SIMS_EXTRACURRICULAR_ENABLED=0
SIMS_EXTRACURRICULAR_RATE=120/min
SIMS_EXTRACURRICULAR_EVENT_HANDLER=

# M30 awards (enable only after M15 grants and M13 storage configuration)
SIMS_AWARDS_ENABLED=0
SIMS_AWARDS_EVENT_HANDLER=
SIMS_AWARDS_RATE=120/min

# M31 professional memberships
SIMS_PROFESSIONAL_MEMBERSHIPS_ENABLED=0
SIMS_PROFESSIONAL_MEMBERSHIPS_EVENT_HANDLER=
SIMS_PROFESSIONAL_MEMBERSHIPS_RATE=120/min
SIMS_MEMBERSHIPS_RENEWAL_WINDOW_DAYS=30
SIMS_MEMBERSHIPS_AUTO_EXPIRY_ENABLED=0
