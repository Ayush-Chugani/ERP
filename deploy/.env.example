# Copy outside the release directory to /etc/sims/runtime.env (owner root:sims, mode 0640).
DJANGO_SECRET_KEY=replace-with-a-generated-production-secret
DJANGO_ALLOWED_HOSTS=example.invalid
SIMS_DB_NAME=sims_production
SIMS_DB_USER=sims_runtime
SIMS_DB_PASSWORD=replace-with-runtime-database-password
SIMS_DB_HOST=127.0.0.1
SIMS_DB_PORT=3306
SIMS_DISPLAY_TIME_ZONE=Asia/Calcutta
SIMS_HSTS_SUBDOMAINS=0
SIMS_HSTS_PRELOAD=0

# M26: enable only after scoped grants and institutional finance acceptance.
SIMS_FUNDED_PROJECTS_ENABLED=0
SIMS_FUNDED_PROJECTS_CURRENCIES=INR
SIMS_FUNDED_PROJECTS_RATE=120/min

# M27: stage permissions and finance acceptance before activation.
SIMS_CONSULTANCY_ENABLED=0
SIMS_CONSULTANCY_RATE=120/min

# M28: configure permissions, scanner and adapter before activation.
SIMS_COCURRICULAR_ENABLED=0
SIMS_COCURRICULAR_RATE=120/min
SIMS_COCURRICULAR_EVENT_HANDLER=

# M29 extra-curricular activities
SIMS_EXTRACURRICULAR_ENABLED=0
SIMS_EXTRACURRICULAR_RATE=120/min
SIMS_EXTRACURRICULAR_EVENT_HANDLER=

# M32: configure scoped M15 grants and accepted contribution type policies before enabling.
SIMS_PROFESSIONAL_CONTRIBUTIONS_ENABLED=0
SIMS_PROFESSIONAL_CONTRIBUTIONS_EVENT_HANDLER=

# M33 centralized evidence: configure M13 private storage/scanner and scoped M15 grants before enabling.
SIMS_EVIDENCE_ENABLED=0
SIMS_EVIDENCE_ALLOW_SELF_VERIFY=0
SIMS_EVIDENCE_REQUIRE_VERIFIED_APPROVAL=1
SIMS_EVIDENCE_NOTIFICATION_HANDLER=
SIMS_EVIDENCE_RATE=120/min
